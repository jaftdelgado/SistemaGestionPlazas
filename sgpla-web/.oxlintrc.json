{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc"],
  "jsPlugins": [
    "@tanstack/eslint-plugin-query",
    "@tanstack/eslint-plugin-router"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/router/create-route-property-order": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/modules/*/**"],
            "message": "Un módulo se importa solo por su contrato (@/modules/<modulo>); dentro del módulo se usan rutas relativas."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "localStorage",
        "message": "El almacenamiento del navegador solo se usa en la capa storage de un módulo."
      },
      {
        "name": "sessionStorage",
        "message": "El almacenamiento del navegador solo se usa en la capa storage de un módulo."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/modules/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "react",
                  "react-dom",
                  "@tanstack/*",
                  "../api/*",
                  "../storage/*",
                  "../hooks/*",
                  "../pages/**",
                  "../components/**"
                ],
                "message": "domain es TypeScript puro: no depende de otras capas, de otros módulos, de shared ni de React o TanStack."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": [
                  "useQuery",
                  "useSuspenseQuery",
                  "useQueries",
                  "useSuspenseQueries",
                  "useInfiniteQuery",
                  "useSuspenseInfiniteQuery",
                  "useMutation",
                  "useQueryClient",
                  "useIsFetching",
                  "useIsMutating",
                  "QueryClientProvider"
                ],
                "message": "api solo define consultas y llamadas; los hooks de TanStack Query se usan en la capa hooks."
              }
            ],
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/*/**"],
                "message": "api solo se conecta con los recursos de su módulo; los datos de otro módulo se piden desde hooks, por su contrato."
              },
              {
                "group": [
                  "react",
                  "react-dom",
                  "@tanstack/react-router",
                  "@/shared/ui/**",
                  "@/shared/hooks/**",
                  "@/shared/lib/notifications",
                  "../storage/*",
                  "../hooks/*",
                  "../pages/**",
                  "../components/**"
                ],
                "message": "api depende solo de domain y de shared/api: sin React, router, interfaz ni las capas superiores."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/storage/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "react",
                  "react-dom",
                  "@tanstack/*",
                  "../api/*",
                  "../hooks/*",
                  "../pages/**",
                  "../components/**"
                ],
                "message": "storage solo adapta el navegador: depende únicamente de domain."
              }
            ]
          }
        ],
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["src/modules/*/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/modules/*/**"],
                "message": "Un módulo se importa solo por su contrato (@/modules/<modulo>); dentro del módulo se usan rutas relativas."
              },
              {
                "group": [
                  "../pages/**",
                  "../components/**",
                  "@/shared/ui/**",
                  "@/shared/api/client"
                ],
                "message": "hooks no depende de la interfaz ni llama al cliente HTTP: los datos llegan por api."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-router",
                "importNames": [
                  "useNavigate",
                  "useSearch",
                  "useParams",
                  "useRouterState",
                  "useRouter",
                  "useLocation",
                  "useMatch",
                  "useLoaderData",
                  "useRouteContext",
                  "useBlocker",
                  "getRouteApi",
                  "redirect"
                ],
                "message": "La interfaz no navega ni lee la dirección: eso lo hace su hook. Solo puede usar Link y Outlet."
              }
            ],
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/*/**"],
                "message": "Una página llega a otros módulos solo por su hook."
              },
              {
                "group": [
                  "../api/*",
                  "../storage/*",
                  "../domain/*",
                  "@/shared/api/**",
                  "@/shared/lib/notifications",
                  "@tanstack/react-query"
                ],
                "message": "Una página usa su hook y compone componentes: no consulta datos, no avisa ni conoce el dominio."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-router",
                "importNames": [
                  "useNavigate",
                  "useSearch",
                  "useParams",
                  "useRouterState",
                  "useRouter",
                  "useLocation",
                  "useMatch",
                  "useLoaderData",
                  "useRouteContext",
                  "useBlocker",
                  "getRouteApi",
                  "redirect",
                  "Outlet"
                ],
                "message": "Un componente no navega ni lee la dirección: solo puede usar Link."
              }
            ],
            "patterns": [
              {
                "group": ["@/modules/*", "@/modules/*/**"],
                "message": "Un componente recibe todo por props: no importa otros módulos."
              },
              {
                "group": [
                  "../hooks/*",
                  "../api/*",
                  "../storage/*",
                  "../domain/*",
                  "../pages/*",
                  "@/shared/api/**",
                  "@/shared/lib/notifications",
                  "@tanstack/react-query"
                ],
                "message": "Un componente es pasivo: recibe datos y callbacks por props y no depende de hooks, api, domain ni pages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/*",
                  "@/modules/*/**",
                  "@/shared/api/**",
                  "@tanstack/react-query"
                ],
                "message": "shared/ui es presentación compartida: no conoce los módulos ni la API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/hooks/**", "src/shared/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/*",
                  "@/modules/*/**",
                  "@/shared/ui/**",
                  "@/shared/api/**"
                ],
                "message": "shared/hooks y shared/lib son utilidades genéricas: no conocen los módulos, la interfaz ni la API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/*",
                  "@/modules/*/**",
                  "@/shared/ui/**",
                  "@/shared/hooks/**"
                ],
                "message": "shared/api es la conexión común con la API: no conoce los módulos ni la interfaz."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "src/routeTree.gen.ts",
    "src/shared/api/schema.d.ts",
    "tools/"
  ]
}
