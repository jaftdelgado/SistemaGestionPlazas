# Copiar a .env y ajustar. .env no se versiona.

# Contraseña de 'sa' del SQL Server local (mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos).
SGPLA_SA_PASSWORD=Sgpla_Dev_2026!

# Puertos publicados en el host.
SGPLA_SQL_PORT=1433
SGPLA_API_PORT=8180

# Entorno de la API dentro del contenedor. Development habilita /openapi y /scalar.
SGPLA_API_ENVIRONMENT=Development

# Origen del frontend permitido por CORS.
SGPLA_WEB_ORIGIN=http://localhost:5173

# Clave de firma de los JWT de sesión (al menos 32 caracteres). NUNCA uses este valor fuera de desarrollo.
SGPLA_JWT_CLAVE=clave-de-desarrollo-cambia-esto-en-produccion-1234

# LDAP de la UV. Los valores actuales del directorio solo se aceptan sin TLS en el entorno Development.
SGPLA_LDAP_SERVIDOR=148.226.12.10
SGPLA_LDAP_PUERTO=389
SGPLA_LDAP_SEGURIDAD=SinTls

# Correo y nombre del primer Superusuario, usados por 'docker compose run --rm api bootstrap-superusuario'.
SGPLA_BOOTSTRAP_CORREO=
SGPLA_BOOTSTRAP_NOMBRE=
